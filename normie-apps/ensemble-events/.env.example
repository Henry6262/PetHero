# All optional — the /api/lead endpoint runs without any of these (logs leads to console).
# Configure in Vercel project settings before launch.

# Instant team notification (Slack incoming webhook)
SLACK_WEBHOOK_URL=

# Generic lead store: Google Sheet via Apps Script / Make / Zapier / CRM webhook
LEAD_WEBHOOK_URL=

# Email (Resend) — internal notification + branded autoresponder
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@yourdomain.ch
LEAD_FROM_EMAIL=hello@yourdomain.ch

# Privacy-friendly analytics (optional)
PLAUSIBLE_DOMAIN=
