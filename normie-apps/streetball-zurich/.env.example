# All optional — the /api/register endpoint runs and returns 200 even with none set.
# When unconfigured, registrations are logged to the server console.

# Instant team notification on a new registration
SLACK_WEBHOOK_URL=

# Generic lead store (Google Sheet / Make / Zapier / CRM webhook)
LEAD_WEBHOOK_URL=

# Resend — internal notification + autoresponder
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
