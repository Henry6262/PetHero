{
  "name": "solana-event-pass",
  "version": "0.1.0",
  "description": "Unified Solana-native event app: agenda, token wallet, payments, and POAPs",
  "type": "module",
  "scripts": {
    "dev": "BUN_CONFIG_NO_RELOAD=1 bun run --filter @solana-event-pass/api dev",
    "db:generate": "bun run --filter @solana-event-pass/db generate",
    "db:migrate": "bun run --filter @solana-event-pass/db migrate",
    "db:seed": "bun run --filter @solana-event-pass/db seed",
    "db:studio": "bun run --filter @solana-event-pass/db studio",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
