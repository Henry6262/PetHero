generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id        String          @id // market_hash_name e.g. "AK-47 | Redline (Field-Tested)"
  name      String
  type      String // "Rifle", "Knife", "Gloves", etc.
  rarity    String // "Mil-Spec", "Restricted", "Classified", etc.
  createdAt DateTime        @default(now())
  listings  Listing[]
  snapshots PriceSnapshot[]
  sales     SaleEvent[]
}

model Listing {
  id          String       @id
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD")
  floatValue  Float?
  paintSeed   Int?
  state       ListingState @default(ACTIVE)
  listedAt    DateTime
  updatedAt   DateTime     @updatedAt

  @@index([itemId, state])
  @@index([marketplace, state])
}

model PriceSnapshot {
  id          String      @id @default(cuid())
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  minPrice    Decimal     @db.Decimal(12, 2)
  medianPrice Decimal     @db.Decimal(12, 2)
  volume24h   Int
  snappedAt   DateTime    @default(now())

  @@index([itemId, snappedAt])
  @@index([marketplace, snappedAt])
}

model SaleEvent {
  id          String      @id
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  price       Decimal     @db.Decimal(12, 2)
  floatValue  Float?
  paintSeed   Int?
  soldAt      DateTime

  @@index([itemId, soldAt])
  @@index([marketplace, soldAt])
}

enum Marketplace {
  SKINPORT
  CSFLOAT
  DMARKET
}

enum ListingState {
  ACTIVE
  SOLD
  CANCELLED
}
