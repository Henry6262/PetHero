generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id        String          @id // market_hash_name e.g. "AK-47 | Redline (Field-Tested)"
  name      String
  type      String // "Rifle", "Knife", "Gloves", etc.
  rarity    String // "Mil-Spec", "Restricted", "Classified", etc.
  createdAt DateTime        @default(now())
  
  listings           Listing[]
  snapshots          PriceSnapshot[]
  sales              SaleEvent[]
  opportunityScores  OpportunityScore[]
  tradeAttempts      TradeAttempt[]
  executionCycles    ExecutionCycle[]
}

model Listing {
  id          String       @id
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD")
  floatValue  Float?
  paintSeed   Int?
  state       ListingState @default(ACTIVE)
  listedAt    DateTime
  updatedAt   DateTime     @updatedAt

  @@index([itemId, state])
  @@index([marketplace, state])
}

model PriceSnapshot {
  id          String      @id @default(cuid())
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  minPrice    Decimal     @db.Decimal(12, 2)
  medianPrice Decimal     @db.Decimal(12, 2)
  volume24h   Int
  snappedAt   DateTime    @default(now())

  @@index([itemId, snappedAt])
  @@index([marketplace, snappedAt])
}

model SaleEvent {
  id          String      @id
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  marketplace Marketplace
  price       Decimal     @db.Decimal(12, 2)
  floatValue  Float?
  paintSeed   Int?
  soldAt      DateTime

  @@index([itemId, soldAt])
  @@index([marketplace, soldAt])
}

enum Marketplace {
  SKINPORT
  CSFLOAT
  DMARKET
}

enum ListingState {
  ACTIVE
  SOLD
  CANCELLED
}

model OpportunityScore {
  itemId            String
  marketplace       Marketplace
  score             Float
  expectedProfitPct Float
  listedPrice       Decimal     @db.Decimal(12, 2)
  targetSellPrice   Decimal     @db.Decimal(12, 2)
  volume24h         Int
  
  // Phase 3 ML Fields
  predictedValue    Decimal?    @db.Decimal(12, 2)
  confidence        Float?      @default(0.0)
  modelId           String?

  scoredAt          DateTime    @updatedAt
  item              Item        @relation(fields: [itemId], references: [id])

  @@id([itemId, marketplace])
  @@index([marketplace, score])
}

model TradeAttempt {
  id                String      @id @default(uuid())
  itemId            String
  marketplace       Marketplace
  buyPrice          Decimal     @db.Decimal(12, 2)
  resellPrice       Decimal     @db.Decimal(12, 2)
  expectedProfitPct Float
  expectedNetProfit Decimal     @db.Decimal(12, 2)
  score             Float
  confidence        Float?
  mode              String      @default("PAPER")
  status            String      // "SUCCESS", "FAILED", "INSUFFICIENT_FUNDS", "API_ERROR"
  error             String?
  orderId           String?
  cycleId           String?
  attemptedAt       DateTime    @default(now())

  item              Item        @relation(fields: [itemId], references: [id])
  cycle             ExecutionCycle? @relation(fields: [cycleId], references: [id])

  @@index([attemptedAt])
  @@index([status, attemptedAt])
}

model ExecutionCycle {
  id                      String       @id @default(uuid())
  mode                    String
  status                  String
  candidateCount          Int
  qualifiedCount          Int
  affordableCount         Int          @default(0)
  selectedItemId          String?
  selectedBuyPrice        Decimal?     @db.Decimal(12, 2)
  selectedTargetSellPrice Decimal?     @db.Decimal(12, 2)
  selectedExpectedProfitPct Float?
  selectedExpectedNetProfit Decimal?   @db.Decimal(12, 2)
  selectedScore           Float?
  selectedConfidence      Float?
  reason                  String?
  executedAt              DateTime     @default(now())

  item                    Item?        @relation(fields: [selectedItemId], references: [id])
  tradeAttempts           TradeAttempt[]

  @@index([executedAt])
}
