          { "name": "bump", "type": "u8" },
          { "name": "vaultBump", "type": "u8" }
        ]
      }
    },
    {
      "name": "Donation",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "donor", "type": "publicKey" },
          { "name": "campaign", "type": "publicKey" },
          { "name": "amount", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
